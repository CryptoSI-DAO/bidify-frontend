# Bidify V2 frontend environment (all optional)
# Auction data is chain-derived — no API keys required.

# Cloudflare image worker base URL (no trailing slash).
# When set, NFT images route through https://<worker>/img?url=<encoded>
# REACT_APP_IMAGE_WORKER=https://images.bidify.example.workers.dev

# Mailchimp (newsletter embeds) — optional
# REACT_APP_MAILCHIMP_U=
# REACT_APP_MAILCHIMP_ID=
